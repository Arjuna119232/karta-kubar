# Konfigurasi backend KUNBAR Connect
# ---------------------------------------------------------------
# Salin file ini jadi `.env`, isi nilainya, lalu JANGAN pernah
# commit `.env` (sudah masuk .gitignore).
#
# File ini dibaca build lewat `--dart-define`. Contoh di `tool/build.sh`
# dan di `.github/workflows/build.yml`.
#
# AMAN untuk ditulis di sini:
#   SUPABASE_ANON_KEY  -> kunci publik, wajib ada di dalam aplikasi,
#                         sudah dibatasi aturan RLS di sisi server.
# TIDAK BOLEH PERNAH ditulis di sini:
#   service_role key   -> kalau bocor, siapa pun bisa baca/tulis
#                         seluruh database tanpa batas RLS.

# `lokal`   = data di perangkat + seed demo (tidak butuh server)
# `supabase`= data dari Supabase
SUMBER_DATA=lokal

# Project URL, contoh: https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Anon / publishable key
SUPABASE_ANON_KEY=

# Skema Postgres
SUPABASE_SCHEMA=public

# Bucket untuk foto absen & galeri
SUPABASE_STORAGE_BUCKET=kunar-uploads

# ---flutter run di Termux (tidak punya flutter)---
# Setelah Flutter terpasang di mesin Anda:
#   flutter run --dart-define=SUMBER_DATA=supabase \
#               --dart-define=SUPABASE_URL=https://xxx.supabase.co \
#               --dart-define=SUPABASE_ANON_KEY=eyJ...
